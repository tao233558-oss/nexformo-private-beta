# Copy this file to .env. API keys stay on the server and never enter the browser.
# Without a key, the visual canvas and typed companion use the local fallback.

# Production/private-beta settings. Leave BETA_ACCESS_CODE empty to disable the gate.
# PUBLIC_ORIGIN must be the exact public HTTPS origin, without a path.
APP_BUILD_ID=private-beta
PUBLIC_ORIGIN=
BETA_ACCESS_CODE=
# Use a random value of at least 32 characters. Never reuse an API key here.
BETA_SESSION_SECRET=

AI_PROVIDER=deepseek

# DeepSeek powers typed conversation, emotion, and particle interpretation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI configuration. It enables premium Realtime voice and can also
# become the main text provider by changing AI_PROVIDER to openai.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.6-sol

# Backward-compatible override for the older scene endpoints. Leave blank to use Sol.
OPENAI_MODEL=

# Low-latency speech transport. Voice replies still consult the Sol brain first.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Supported values: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar.
# Unsupported values fall back to marin and are disclosed in the voice status.
OPENAI_REALTIME_VOICE=marin

# Doubao Speech can replace browser/OpenAI voice while DeepSeek remains the brain.
# Create the API key in the new Doubao Speech console; never expose it in the browser.
DOUBAO_SPEECH_API_KEY=
DOUBAO_SPEECH_APP_ID=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_VOICE=

# Optional true singing. This is a separate Volcengine Audio Technology / SAMI
# MemeSong service, not the Doubao Speech API key above. Without it, Nexformo
# still performs an experimental local melodic rendition over Doubao TTS.
DOUBAO_SONG_APPKEY=
DOUBAO_SONG_TOKEN=
DOUBAO_SONG_SPEAKER=zh_female_sing_qingxin
DOUBAO_SONG_TEMPLATE=salut_damour-5

# DeepSeek and OpenAI can both use server-side live web search.
ENABLE_WEB_SEARCH=true

# YouTube Data API v3 powers Sol's song search. Keep this key server-side.
# Never rename it with a VITE_ prefix or expose it to browser code.
YOUTUBE_API_KEY=

# Optional HTTP(S) proxy for server-side YouTube API calls in restricted networks.
# Example: http://127.0.0.1:7890 — keep this server-side and omit it when not needed.
YOUTUBE_PROXY_URL=
